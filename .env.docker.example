# Pred spustením Docker Compose skopírujte tento súbor na .env.docker.
# Povinné prázdne hodnoty doplňte podľa produkčného prostredia.

# Aplikácia je predvolene dostupná iba z lokálneho reverzného proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
APP_URL=

# SMTP je v produkcii povinné pre overovacie e-maily registrácie.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
